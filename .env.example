# Public subscribe API (defaults to https://app.frontiernews.tech)
NEXT_PUBLIC_FRONTIERNOTES_API_URL=https://app.frontiernews.tech

# Cloudflare Turnstile site key (public). Required for the newsletter form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# GA4 measurement ID (public, e.g. G-XXXXXXXXXX). Empty = no analytics, no
# consent banner, and zero gtag/googletagmanager strings in dist/.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
